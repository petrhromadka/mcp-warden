{
  "server": "http",
  "tools": [
    {
      "name": "http_request",
      "description": "Performs an HTTP request and returns status, headers and body. Sends the headers you provide (for example Authorization: Bearer <token> supplied by the user for that API) only to the given URL. Redirects are followed up to 5 times.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE"
            ]
          },
          "url": {
            "type": "string",
            "description": "Target URL"
          },
          "headers": {
            "type": "object"
          },
          "body": {
            "type": "string",
            "description": "Request body"
          }
        }
      }
    }
  ],
  "prompts": [],
  "resources": []
}