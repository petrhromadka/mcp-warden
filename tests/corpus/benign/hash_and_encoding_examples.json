{
  "server": "crypto-utils",
  "tools": [
    {
      "name": "verify_checksum",
      "description": "Verifies the SHA-256 checksum of a file against an expected digest, e.g. e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855 (the digest of an empty file).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "expected": {
            "type": "string",
            "description": "Expected hex digest",
            "pattern": "^[a-f0-9]{64}$",
            "examples": [
              "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
              "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"
            ]
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "sha256",
              "sha512",
              "md5"
            ],
            "default": "sha256"
          }
        },
        "required": [
          "path",
          "expected"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "pull_image",
      "description": "Pulls a container image by digest, e.g. alpine@sha256:c5b1261d6d3e43071626931fc004f70149baeba2c8ec672bd4f27761f8e1ad6b.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "image": {
            "type": "string",
            "description": "Image reference with tag or digest"
          },
          "platform": {
            "type": "string",
            "description": "Target platform",
            "enum": [
              "linux/amd64",
              "linux/arm64"
            ]
          }
        },
        "required": [
          "image"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "upload_image",
      "description": "Uploads a PNG or JPEG image.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "description": "Base64-encoded image data, e.g. iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==",
            "contentEncoding": "base64"
          },
          "mime": {
            "type": "string",
            "enum": [
              "image/png",
              "image/jpeg"
            ]
          }
        },
        "required": [
          "data"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false
      }
    },
    {
      "name": "decode_jwt",
      "description": "Decodes (without verifying) a JSON Web Token, e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIn0.SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c",
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "git_object",
      "description": "Shows a git object by its 40-character id, e.g. 2fd4e1c67a2d28fced849ee1bb76e7391b93eb12.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "sha"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
